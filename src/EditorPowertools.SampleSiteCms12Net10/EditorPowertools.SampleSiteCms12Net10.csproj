<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    CMS 12 on .NET 10: a copy of EditorPowertools.SampleSite on the newest CMS 12 packages. It uses the
    libraries' net8.0 (CMS 12) build, which is what the .Cms12 packages ship, rolled forward onto .NET 10.
    Data: on first build the CMS 12 sample site's database.zip and blobs.zip are unzipped into App_Data
    here, under its own LocalDB catalog, so both sites keep separate data.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Shares the CMS 12 sample site's user secrets (Graph keys). -->
    <UserSecretsId>5f57d826-0265-4684-b1c7-0c200e3450ae</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="EPiServer" />
    <Using Include="EPiServer.Core" />
    <Using Include="EPiServer.DataAbstraction" />
    <Using Include="EPiServer.DataAnnotations" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPiServer.CMS" Version="12.35.0" />
    <!-- Optimizely's .NET 10 minimum for CMS 12: TinyMCE 4.x does not load on .NET 10. -->
    <PackageReference Include="EPiServer.CMS.TinyMce" Version="5.0.4" />
    <PackageReference Include="Optimizely.ContentGraph.Cms" Version="4.4.5" />
    <PackageReference Include="EPiServer.Forms" Version="5.10.10" />
    <PackageReference Include="Wangkanai.Detection" Version="8.7.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Translations\**\*" />
  </ItemGroup>

  <!--
    The libraries must build as their .Cms12 flavor (net8.0 only, CMS 12); otherwise a net10.0 site gets
    their CMS 13 build. NuGet restore ignores per-reference properties, so the flavor has to be a global
    property: dotnet run -p:EptCmsFlavor=Cms12. For the same reason this project is not in the solution.
  -->
  <ItemGroup>
    <ProjectReference Include="..\EditorPowertools\EditorPowertools.csproj" />
    <ProjectReference Include="..\EditorPowertools.Forms\EditorPowertools.Forms.csproj" />
    <ProjectReference Include="..\EditorPowertools.Graph\EditorPowertools.Graph.csproj" />
  </ItemGroup>

  <Target Name="RequireCms12Flavor" BeforeTargets="Restore;_GenerateRestoreGraph;Build" Condition="'$(EptCmsFlavor)' != 'Cms12'">
    <Error Text="Build this site with -p:EptCmsFlavor=Cms12, for example: dotnet run --project src/EditorPowertools.SampleSiteCms12Net10 -p:EptCmsFlavor=Cms12" />
  </Target>

  <Target Name="UnzipSampleData" BeforeTargets="Build" Condition="!Exists('App_Data\EditorPowertools.SampleSite.mdf')">
    <Unzip SourceFiles="..\EditorPowertools.SampleSite\App_Data\database.zip;..\EditorPowertools.SampleSite\App_Data\blobs.zip" DestinationFolder="App_Data" />
  </Target>

  <!-- Copy module files from the addon projects during build (dev only, NuGet handles this via .targets) -->
  <Target Name="CopyEditorPowertoolsModuleFiles" BeforeTargets="Build">
    <ItemGroup>
      <EditorPowertoolsModuleFiles Include="..\EditorPowertools\modules\_protected\EditorPowertools\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(EditorPowertoolsModuleFiles)" DestinationFiles="@(EditorPowertoolsModuleFiles->'$(MSBuildProjectDirectory)\modules\_protected\EditorPowertools\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyEditorPowertoolsFormsModuleFiles" BeforeTargets="Build">
    <ItemGroup>
      <EditorPowertoolsFormsModuleFiles Include="..\EditorPowertools.Forms\modules\_protected\EditorPowertoolsForms\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(EditorPowertoolsFormsModuleFiles)" DestinationFiles="@(EditorPowertoolsFormsModuleFiles->'$(MSBuildProjectDirectory)\modules\_protected\EditorPowertoolsForms\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyEditorPowertoolsGraphModuleFiles" BeforeTargets="Build">
    <ItemGroup>
      <EditorPowertoolsGraphModuleFiles Include="..\EditorPowertools.Graph\modules\_protected\EditorPowertoolsGraph\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(EditorPowertoolsGraphModuleFiles)" DestinationFiles="@(EditorPowertoolsGraphModuleFiles->'$(MSBuildProjectDirectory)\modules\_protected\EditorPowertoolsGraph\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
