<?xml version="1.0" encoding="utf-8" ?>
<module viewEngine="Razor" clientResourceRelativePath="">
    <assemblies>
        <add assembly="EditorPowertools.Graph" />
    </assemblies>

    <clientResources>
        <add name="editorpowertools-graph.css" path="ClientResources/css/editorpowertools-graph.css" resourceType="Style" />
    </clientResources>

    <dojo>
        <paths>
            <add name="editorpowertools-graph" path="ClientResources/js" />
        </paths>
    </dojo>

    <clientModule>
        <moduleDependencies>
            <add dependency="CMS" type="RunAfter" />
            <add dependency="EditorPowertools" type="RunAfter" />
        </moduleDependencies>
        <requiredResources>
            <add name="editorpowertools-graph.css" />
        </requiredResources>
    </clientModule>
</module>
